# Application
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=CCFC V2

# Database (PostgreSQL — configure in Phase 2 backend setup)
DATABASE_URL=postgresql://user:password@localhost:5432/ccfc_v2

# Authentication (configure with NextAuth.js or Supabase Auth)
NEXTAUTH_SECRET=replace-with-secure-random-secret
NEXTAUTH_URL=http://localhost:3000

# Supabase (optional — if using Supabase instead of direct PostgreSQL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Stripe (configure in payment phase)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Email (configure for transactional email)
EMAIL_FROM=noreply@yourdomain.com
EMAIL_SERVER=smtp://user:password@smtp.example.com:587
